# AY Pizza Mobile App — Environment Configuration Template
# DO NOT commit real secrets (.env or .env.local) to version control!

# ==============================================================================
# Client-Facing Variables (Exposed to Expo Mobile App)
# ==============================================================================
# Supabase Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Publishable Key (Protected by PostgreSQL Row-Level Security)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Paystack Public Key (Never put secret keys in EXPO_PUBLIC_*!)
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# ==============================================================================
# Server-Side / Edge Function Variables (NEVER expose to client mobile app!)
# ==============================================================================
# Supabase Service Role Key (Bypasses RLS — for migrations & webhooks only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paystack Secret Key (Used exclusively by server-side webhook listener)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
